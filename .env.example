# ---------------------------------------------------------------------------
# Ozone Attendance backend - environment template
#
#   cp .env.example .env     then fill in the blanks
#
# `.env` is git-ignored and must never be committed. This file contains
# NO real values - only variable names and non-sensitive defaults.
#
# Variables marked REQUIRED are validated by the Joi schema in
# src/app.module.ts; the application refuses to start if they are missing.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Passed straight to app.listen(); set it or the port is non-deterministic.
PORT=3000

# --- Database (PostgreSQL) - all REQUIRED ---------------------------------
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Auth - REQUIRED ------------------------------------------------------
# Secret used to sign JWTs. Use a long random value; rotating it invalidates
# every issued token.
JWT_SECRET=
# REQUIRED by the Joi schema, but nothing in the code actually reads it -
# the token lifetime is hard-coded to '365d' in src/modules/auth/auth.module.ts.
# It still has to be set or the app will not boot.
JWT_EXPIRATION_TIME=365d

# --- AWS - all REQUIRED ---------------------------------------------------
# Used for S3 profile-image uploads and Rekognition face matching.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BUCKET_NAME=
# NOTE: src/modules/file/file.service.ts and src/helpers/faceMatch.helpers.ts
# read AWS_REIGION (misspelt). It is normally left unset, so the AWS SDK falls
# back to AWS_REGION above and the app works by accident. Left as-is so as not
# to change behaviour - only set this if you deliberately want to override the
# region for S3/Rekognition.
# AWS_REIGION=

# --- Email (Mailjet) ------------------------------------------------------
# Used for password-reset / OTP mail.
MAILJET_API=
MAILJET_SECRET=
# "From" address and display name on outgoing mail.
EMAIL_USER=
EMAIL_SENDER_NAME=

# --- Error reporting ------------------------------------------------------
# Bugsnag rejects anything that is not 32 hex characters.
BUGSNAG_API_KEY=

# --- Integrations ---------------------------------------------------------
# Base URL of the upstream Ozone backend used by the attendance sync.
OZONE_BACKEND_BASE_URL=
# Guards the destructive maintenance endpoints on /employee
# (truncate/:secret, bulk-create/:secret). Treat as a credential.
MANAGEMENT_SECRET=

# --- Feature flags --------------------------------------------------------
IS_SYNC=false
IS_VPN_DETECTION=false
IS_ANDROID_EXACT_VERSION_MATCH=false
IS_IOS_EXACT_VERSION_MATCH=false

# ---------------------------------------------------------------------------
# Referenced ONLY inside commented-out code - not needed to run the app:
#   EMAIL_SERVICE, EMAIL_PASSWORD                 (old nodemailer transport)
#   SAND_GRID_API_KEY                             (old SendGrid transport)
#   CLOUDWATCH_GROUP_NAME, CLOUDWATCH_STREAM_NAME (winston-cloudwatch logger)
#
# Found in existing .env files but not read anywhere in the code:
#   API_SERVER_BASE_URL, CDN_DOMAIN_NAME, FACE_API_SERVER_BASE_URL,
#   TEST_EMAIL, secretOrPrivateKey
# ---------------------------------------------------------------------------
